# Gemini API Key (Required for AI Fallback and Packing Assistant)
# Get a key from: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# Data gateway mode (default: false)
# false → use structured mock data for Mission Peak, Henry Cowell, Yosemite Eagle Peak
# true  → activate Antigravity agent tool stubs for real external data sources
USE_REAL_TIME_DATA=false

# --- Real-Time Mode API Keys (Required only when USE_REAL_TIME_DATA=true) ---

# OpenWeather API Key (Required for real-time weather retrieval)
# Get a key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Brave Search API Key (Required for real-time trail search via Brave Search MCP)
# Get a key from: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

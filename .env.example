# Gemini API Key (Required for AI Fallback and Packing Assistant)
# Get a key from: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# Data gateway mode (default: false)
# false → use structured mock data for Mission Peak, Henry Cowell, Yosemite Eagle Peak
# true  → activate Antigravity agent tool stubs for real external data sources
USE_REAL_TIME_DATA=false
